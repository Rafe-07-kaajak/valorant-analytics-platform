# Absolute base URL used to generate robots.txt and sitemap.xml.
# Defaults to http://localhost:3000 when unset. Set this to the
# production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TASK-047 — real (historical-replay) prediction backend integration.
# See docs/35-real-prediction-backend-integration.md. All optional; safe
# defaults mean historical replay reports itself as gracefully unavailable
# (never a crash) when the local generated model/feature data is absent.

# Master kill switch for the historical-real-model routes. Default: true.
# REAL_PREDICTION_ENABLED=true

# Root `vlr-data` directory (contains a `features/` subdirectory). Defaults
# to `services/vlr-ingestion/.local/vlr-data`, resolved relative to this
# package's own location on disk.
# REAL_PREDICTION_FEATURE_DATA_DIR=

# Upper bound on any single historical-catalog response. Default: 50 (clamped 1-200).
# REAL_PREDICTION_CATALOG_LIMIT=50

# Reused from TASK-046 (services/model-inference) — see that service's own
# documented environment variables (MODEL_INFERENCE_ARTIFACT_DIR,
# MODEL_INFERENCE_REQUIRE_MODEL_ON_START, etc.) for controlling the
# underlying model artifact this task's routes load.

# TASK-048 — production packaging / runtime-package source mode.
# See docs/36-real-prediction-runtime-packaging.md. All optional; the
# default (local-generated) preserves TASK-047 behavior exactly.

# Which data source to read from: "local-generated" (default, today's raw
# .local/vlr-data directories) or "runtime-package" (a built, hash-verified
# staging directory produced by `pnpm runtime:package:build`).
# REAL_PREDICTION_SOURCE_MODE=local-generated

# Only consulted when REAL_PREDICTION_SOURCE_MODE=runtime-package. Defaults
# to services/model-inference/.local/runtime-package, resolved relative to
# this package's own location on disk.
# REAL_PREDICTION_RUNTIME_PACKAGE_DIR=

# When true (and source mode is runtime-package), a missing/invalid package
# fails loud at first use instead of reporting a normal unavailable state.
# Default: false.
# REAL_PREDICTION_REQUIRE_RUNTIME_PACKAGE=false

# Optional pinned runtimePackageVersion; a mismatch is reported as
# runtime_package_version_mismatch. Default: unset (any version accepted).
# REAL_PREDICTION_EXPECTED_RUNTIME_PACKAGE_VERSION=

# TASK-049 — release pipeline CLI configuration (services/release-pipeline).
# See docs/37-release-pipeline-and-operational-readiness.md. All optional;
# every default is resolved relative to the release-pipeline package's own
# location on disk, mirroring every other config module in this repo. None
# of these are read by apps/web itself — they only configure the
# `pnpm release:*` tooling.

# Where `release:bundle:build` stages a release bundle. Defaults to
# services/release-pipeline/.local/release-bundle.
# RELEASE_BUNDLE_OUTPUT_DIR=

# apps/web's own root directory, read to compute applicationBuildFingerprint.
# Defaults to apps/web.
# RELEASE_APP_SOURCE_DIR=

# An already-built TASK-048 runtime package to consume. Defaults to
# services/model-inference/.local/runtime-package.
# RELEASE_RUNTIME_PACKAGE_DIR=

# Where promotion/release-state metadata is written. Defaults to
# services/release-pipeline/.local/release-state.
# RELEASE_STATE_DIR=

# Optional pinned runtimePackageVersion the release bundle build should
# require. Default: unset (any validated version accepted).
# RELEASE_EXPECTED_RUNTIME_PACKAGE_VERSION=

# When true, `pnpm release:preflight` fails its "source" section if the
# working tree has uncommitted changes. Default: false (informational only).
# RELEASE_REQUIRE_CLEAN_TREE=false
