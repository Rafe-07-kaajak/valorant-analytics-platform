{
  "name": "@repo/release-pipeline",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testFixtures": "./src/testFixtures/buildFixtureReleaseInputs.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "check-types": "tsc --noEmit",
    "test": "vitest run",
    "release:audit": "tsx src/cli/audit.ts",
    "release:preflight": "tsx src/cli/preflight.ts",
    "release:bundle:build": "tsx src/cli/bundleBuild.ts",
    "release:bundle:validate": "tsx src/cli/bundleValidate.ts",
    "release:bundle:status": "tsx src/cli/bundleStatus.ts",
    "release:bundle:inspect": "tsx src/cli/bundleInspect.ts",
    "release:bundle:clean": "tsx src/cli/bundleClean.ts",
    "release:deploy:dry-run": "tsx src/cli/deployDryRun.ts",
    "release:promote": "tsx src/cli/promote.ts",
    "release:rollback:manifest": "tsx src/cli/rollbackManifest.ts"
  },
  "dependencies": {
    "@repo/model-inference": "workspace:*",
    "@repo/vlr-ingestion": "workspace:*"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "^20",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
