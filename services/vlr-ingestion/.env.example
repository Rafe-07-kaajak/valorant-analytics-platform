# Master kill switch. Live ingestion commands refuse to make any network
# request unless this is explicitly "true". Fixture and unit tests never
# read this value in a way that enables network access.
VLR_NETWORK_ENABLED=false

# Only this exact host, over https, is ever fetched — see src/vlr/urlBuilder.ts.
VLR_BASE_URL=https://www.vlr.gg

# Optional contact string appended to the User-Agent header, for attribution.
# VLR_CONTACT=engineering@example.com

# Conservative request policy. Values are clamped to a safe range regardless
# of what is configured here — see src/env.ts.
VLR_MIN_REQUEST_INTERVAL_MS=2000
VLR_MAX_CONCURRENCY=1
VLR_REQUEST_TIMEOUT_MS=15000
VLR_MAX_RESPONSE_BYTES=2000000
VLR_MAX_RETRIES=2

# Raw HTML is never stored unless explicitly enabled.
VLR_RAW_HTML_STORAGE=false

# Local filesystem store root (gitignored).
VLR_DATA_DIR=.local/vlr-data

# Canonical backfill start date — see docs/29-vlr-data-ingestion-foundation.md.
VLR_BACKFILL_START_DATE=2025-01-01
