# Absolute base URL used to generate robots.txt and sitemap.xml.
# Defaults to http://localhost:3000 when unset. Set this to the
# production domain when deploying.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# TASK-047 — real (historical-replay) prediction backend integration.
# See docs/35-real-prediction-backend-integration.md. All optional; safe
# defaults mean historical replay reports itself as gracefully unavailable
# (never a crash) when the local generated model/feature data is absent.

# Master kill switch for the historical-real-model routes. Default: true.
# REAL_PREDICTION_ENABLED=true

# Root `vlr-data` directory (contains a `features/` subdirectory). Defaults
# to `services/vlr-ingestion/.local/vlr-data`, resolved relative to this
# package's own location on disk.
# REAL_PREDICTION_FEATURE_DATA_DIR=

# Upper bound on any single historical-catalog response. Default: 50 (clamped 1-200).
# REAL_PREDICTION_CATALOG_LIMIT=50

# Reused from TASK-046 (services/model-inference) — see that service's own
# documented environment variables (MODEL_INFERENCE_ARTIFACT_DIR,
# MODEL_INFERENCE_REQUIRE_MODEL_ON_START, etc.) for controlling the
# underlying model artifact this task's routes load.
