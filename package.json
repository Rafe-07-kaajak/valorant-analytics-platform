{
  "name": "valorant-analytics-platform",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml,css}\" --ignore-unknown",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,md,json,yml,yaml,css}\" --ignore-unknown",
    "ingest:vlr:fixtures": "pnpm --filter @repo/vlr-ingestion run ingest:fixtures",
    "ingest:vlr:scope:dry-run": "pnpm --filter @repo/vlr-ingestion run ingest:scope:dry-run",
    "ingest:vlr:match": "pnpm --filter @repo/vlr-ingestion run ingest:match",
    "ingest:vlr:event": "pnpm --filter @repo/vlr-ingestion run ingest:event",
    "ingest:vlr:smoke": "pnpm --filter @repo/vlr-ingestion run ingest:smoke",
    "ingest:vlr:discover": "pnpm --filter @repo/vlr-ingestion run ingest:discover",
    "ingest:vlr:backfill": "pnpm --filter @repo/vlr-ingestion run ingest:backfill",
    "ingest:vlr:resume": "pnpm --filter @repo/vlr-ingestion run ingest:backfill",
    "ingest:vlr:retry": "pnpm --filter @repo/vlr-ingestion run ingest:retry",
    "ingest:vlr:report": "pnpm --filter @repo/vlr-ingestion run ingest:report",
    "ingest:vlr:validate": "pnpm --filter @repo/vlr-ingestion run ingest:validate",
    "ingest:vlr:manifest": "pnpm --filter @repo/vlr-ingestion run ingest:manifest",
    "ingest:vlr:status": "pnpm --filter @repo/vlr-ingestion run ingest:status",
    "ingest:vlr:identity:audit": "pnpm --filter @repo/vlr-ingestion run ingest:identity:audit",
    "ingest:vlr:identity:teams": "pnpm --filter @repo/vlr-ingestion run ingest:identity:teams",
    "ingest:vlr:identity:players": "pnpm --filter @repo/vlr-ingestion run ingest:identity:players",
    "ingest:vlr:quality:audit": "pnpm --filter @repo/vlr-ingestion run ingest:quality:audit",
    "ingest:vlr:quality:reconcile": "pnpm --filter @repo/vlr-ingestion run ingest:quality:reconcile",
    "ingest:vlr:quality:validate": "pnpm --filter @repo/vlr-ingestion run ingest:quality:validate",
    "ingest:vlr:curate": "pnpm --filter @repo/vlr-ingestion run ingest:curate",
    "ingest:vlr:curated:status": "pnpm --filter @repo/vlr-ingestion run ingest:curated:status",
    "ingest:vlr:cleanup": "pnpm --filter @repo/vlr-ingestion run ingest:cleanup",
    "ingest:vlr:mapping:import": "pnpm --filter @repo/vlr-ingestion run ingest:mapping:import",
    "ingest:vlr:features:audit": "pnpm --filter @repo/vlr-ingestion run ingest:features:audit",
    "ingest:vlr:features:build": "pnpm --filter @repo/vlr-ingestion run ingest:features:build",
    "ingest:vlr:features:validate": "pnpm --filter @repo/vlr-ingestion run ingest:features:validate",
    "ingest:vlr:features:status": "pnpm --filter @repo/vlr-ingestion run ingest:features:status",
    "ingest:vlr:features:catalog": "pnpm --filter @repo/vlr-ingestion run ingest:features:catalog",
    "ingest:vlr:features:splits": "pnpm --filter @repo/vlr-ingestion run ingest:features:splits",
    "ingest:vlr:model:audit": "pnpm --filter @repo/vlr-ingestion run ingest:model:audit",
    "ingest:vlr:model:train": "pnpm --filter @repo/vlr-ingestion run ingest:model:train",
    "ingest:vlr:model:backtest": "pnpm --filter @repo/vlr-ingestion run ingest:model:backtest",
    "ingest:vlr:model:evaluate": "pnpm --filter @repo/vlr-ingestion run ingest:model:evaluate",
    "ingest:vlr:model:calibrate": "pnpm --filter @repo/vlr-ingestion run ingest:model:calibrate",
    "ingest:vlr:model:select": "pnpm --filter @repo/vlr-ingestion run ingest:model:select",
    "ingest:vlr:model:status": "pnpm --filter @repo/vlr-ingestion run ingest:model:status",
    "ingest:vlr:model:predict": "pnpm --filter @repo/vlr-ingestion run ingest:model:predict --",
    "inference:model:audit": "pnpm --filter @repo/model-inference run inference:model:audit",
    "inference:model:load": "pnpm --filter @repo/model-inference run inference:model:load",
    "inference:model:status": "pnpm --filter @repo/model-inference run inference:model:status",
    "inference:model:self-test": "pnpm --filter @repo/model-inference run inference:model:self-test",
    "inference:model:predict": "pnpm --filter @repo/model-inference run inference:model:predict --",
    "inference:model:batch": "pnpm --filter @repo/model-inference run inference:model:batch --",
    "inference:model:reload": "pnpm --filter @repo/model-inference run inference:model:reload",
    "inference:model:benchmark": "pnpm --filter @repo/model-inference run inference:model:benchmark",
    "runtime:package:audit": "pnpm --filter @repo/model-inference run runtime:package:audit",
    "runtime:package:build": "pnpm --filter @repo/model-inference run runtime:package:build",
    "runtime:package:validate": "pnpm --filter @repo/model-inference run runtime:package:validate",
    "runtime:package:status": "pnpm --filter @repo/model-inference run runtime:package:status",
    "runtime:package:clean": "pnpm --filter @repo/model-inference run runtime:package:clean",
    "runtime:package:smoke": "pnpm --filter @repo/model-inference run runtime:package:smoke",
    "release:audit": "pnpm --filter @repo/release-pipeline run release:audit",
    "release:preflight": "pnpm --filter @repo/release-pipeline run release:preflight",
    "release:bundle:build": "pnpm --filter @repo/release-pipeline run release:bundle:build",
    "release:bundle:validate": "pnpm --filter @repo/release-pipeline run release:bundle:validate",
    "release:bundle:status": "pnpm --filter @repo/release-pipeline run release:bundle:status",
    "release:bundle:inspect": "pnpm --filter @repo/release-pipeline run release:bundle:inspect",
    "release:bundle:clean": "pnpm --filter @repo/release-pipeline run release:bundle:clean",
    "release:deploy:dry-run": "pnpm --filter @repo/release-pipeline run release:deploy:dry-run",
    "release:promote": "pnpm --filter @repo/release-pipeline run release:promote --",
    "release:rollback:manifest": "pnpm --filter @repo/release-pipeline run release:rollback:manifest",
    "release:smoke:local": "pnpm --filter web run release:smoke",
    "copy-hygiene": "pnpm --filter web run copy-hygiene"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
